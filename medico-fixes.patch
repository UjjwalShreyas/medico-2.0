+# Copy this file to `.env` in the repository root and fill it in. Never commit `.env`.
+
+# --- Gemini (needed for reports + chatbot) ---
+GEMINI_API_KEY=your_google_gemini_api_key
+# Google retires models over time. If answers start failing, check
+# https://ai.google.dev/gemini-api/docs/deprecations and change this.
+GEMINI_MODEL=gemini-3.8-flash
+
+# --- Django backend ---
+# Local development: set DJANGO_DEBUG=1. In production leave it unset (off).
+DJANGO_DEBUG=1
+# Any long random string; generate one with:
+#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
+# If unset, a temporary random key is used (fine for this API, changes on restart).
+DJANGO_SECRET_KEY=
+# Comma-separated hostnames the backend may be served on.
+DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
+# Comma-separated frontend origins allowed to call the API (CORS).
+# Production example: https://your-app.vercel.app
+CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
+# Per-IP rate limit for the API.
+API_THROTTLE_RATE=30/minute
